]},\"subRight\":{\"subLeft\":{\"name\":\"on\",\"terms\":[{\"name\":\"z\"}]},\"subRight\":{\"name\":\"x\"}}},\"subRight\":{\"subLeft\":{\"name\":\"z\"},\"subRight\":{\"name\":\"y\"}}}}}}},\"gameHistory\":[],\"showVariables\":false,\"gameEnabled\":false,\"variableIndex\":1,\"validSyntax\":true},{\"value\":\"∀x ( piece(x) → ¬square(x) ∧ ¬ ∃y clr(y) ≐ x ) ∧ ∀x ( square(x) → ¬ ∃y clr(y) ≐ x )\",\"expressionValue\":true,\"answerValue\":true,\"errorMessage\":\"\",\"inputLocked\":true,\"answerLocked\":true,\"parsed\":{\"subLeft\":{\"variableName\":\"x\",\"subFormula\":{\"subLeft\":{\"name\":\"piece\",\"terms\":[{\"name\":\"x\"}]},\"subRight\":{\"subLeft\":{\"subFormula\":{\"name\":\"square\",\"terms\":[{\"name\":\"x\"}]}},\"subRight\":{\"subFormula\":{\"variableName\":\"y\",\"subFormula\":{\"subLeft\":{\"name\":\"clr\",\"terms\":[{\"name\":\"y\"}]},\"subRight\":{\"name\":\"x\"}}}}}}},\"subRight\":{\"variableName\":\"x\",\"subFormula\":{\"subLeft\":{\"name\":\"square\",\"terms\":[{\"name\":\"x\"}]},\"subRight\":{\"subFormula\":{\"variableName\":\"y\",\"subFormula\":{\"subLeft\":{\"name\":\"clr\",\"terms\":[{\"name\":\"y\"}]},\"subRight\":{\"name\":\"x\"}}}}}}},\"gameHistory\":[],\"showVariables\":false,\"gameEnabled\":false,\"variableIndex\":1,\"validSyntax\":true},{\"value\":\"\\\\forall x \\\\forall y (piece(x) & piece(y) -> ( clr(x) != clr(y) & may_enter(x, on(y)) <-> may_take(x, y) ))\",\"expressionValue\":true,\"answerValue\":true,\"errorMessage\":\"\",\"inputLocked\":false,\"answerLocked\":true,\"parsed\":{\"variableName\":\"x\",\"subFormula\":{\"variableName\":\"y\",\"subFormula\":{\"subLeft\":{\"subLeft\":{\"name\":\"piece\",\"terms\":[{\"name\":\"x\"}]},\"subRight\":{\"name\":\"piece\",\"terms\":[{\"name\":\"y\"}]}},\"subRight\":{\"subLeft\":{\"subLeft\":{\"subFormula\":{\"subLeft\":{\"name\":\"clr\",\"terms\":[{\"name\":\"x\"}]},\"subRight\":{\"name\":\"clr\",\"terms\":[{\"name\":\"y\"}]}}},\"subRight\":{\"name\":\"may_enter\",\"terms\":[{\"name\":\"x\"},{\"name\":\"on\",\"terms\":[{\"name\":\"y\"}]}]}},\"subRight\":{\"name\":\"may_take\",\"terms\":[{\"name\":\"x\"},{\"name\":\"y\"}]}}}}},\"gameHistory\":[],\"showVariables\":false,\"gameEnabled\":false,\"variableIndex\":1,\"validSyntax\":true},{\"value\":\"\\\\forall x ( king(x) -> check(x) <-> \\\\exists y (may_take(y, x) & piece(y)) )\",\"expressionValue\":true,\"answerValue\":true,\"errorMessage\":\"\",\"inputLocked\":false,\"answerLocked\":true,\"parsed\":{\"variableName\":\"x\",\"subFormula\":{\"subLeft\":{\"name\":\"king\",\"terms\":[{\"name\":\"x\"}]},\"subRight\":{\"subLeft\":{\"name\":\"check\",\"terms\":[{\"name\":\"x\"}]},\"subRight\":{\"variableName\":\"y\",\"subFormula\":{\"subLeft\":{\"name\":\"may_take\",\"terms\":[{\"name\":\"y\"},{\"name\":\"x\"}]},\"subRight\":{\"name\":\"piece\",\"terms\":[{\"name\":\"y\"}]}}}}}},\"gameHistory\":[],\"showVariables\":false,\"gameEnabled\":false,\"variableIndex\":1,\"validSyntax\":true},{\"value\":\"\\\\forall x (king(x) -> check_mate(x) <-> \\\\neg \\\\exists y (square(y) & may_enter(x, y)) & check(x))\",\"expressionValue\":true,\"answerValue\":true,\"errorMessage\":\"\",\"inputLocked\":false,\"answerLocked\":true,\"parsed\":{\"variableName\":\"x\",\"subFormula\":{\"subLeft\":{\"name\":\"king\",\"terms\":[{\"name\":\"x\"}]},\"subRight\":{\"subLeft\":{\"name\":\"check_mate\",\"terms\":[{\"name\":\"x\"}]},\"subRight\":{\"subLeft\":{\"subFormula\":{\"variableName\":\"y\",\"subFormula\":{\"subLeft\":{\"name\":\"square\",\"terms\":[{\"name\":\"y\"}]},\"subRight\":{\"name\":\"may_enter\",\"terms\":[{\"name\":\"x\"},{\"name\":\"y\"}]}}}},\"subRight\":{\"name\":\"check\",\"terms\":[{\"name\":\"x\"}]}}}}},\"gameHistory\":[],\"showVariables\":false,\"gameEnabled\":false,\"variableIndex\":1,\"validSyntax\":true},{\"value\":\"∃x ( king(x) ∧ check_mate(x) )\",\"expressionValue\":true,\"answerValue\":true,\"errorMessage\":\"\",\"inputLocked\":true,\"answerLocked\":true,\"parsed\":{\"variableName\":\"x\",\"subFormula\":{\"subLeft\":{\"name\":\"king\",\"terms\":[{\"name\":\"x\"}]},\"subRight\":{\"name\":\"check_mate\",\"terms\":[{\"name\":\"x\"}]}}},\"gameHistory\":[],\"showVariables\":false,\"gameEnabled\":false,\"variableIndex\":1,\"validSyntax\":true}],\"terms\":[]},\"diagramCordState\":{}}",
